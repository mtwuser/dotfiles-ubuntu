# OS-generated
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~

# Secrets — NEVER commit
.ssh/id_*
.ssh/known_hosts
.gnupg/
.netrc

# System & Python cache
.cache/
__pycache__/
*.py[cod]
.ruff_cache/

# Backup files (generated by bootstrap.sh)
*.backup.*

# Machine-local audit exclusions and local shell/git overrides
.audit-ignore
.bashrc.local
.gitconfig.local
